# Flask Configuration
SECRET_KEY=your-secret-key-here
DEBUG=True
HOST=0.0.0.0
PORT=5000

# Database Configuration
# Choose one: sqlite, postgresql, mysql
DATABASE_TYPE=sqlite

# PostgreSQL Configuration (if using postgresql)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vanna_farsi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
# Alternative: Use connection string directly
# POSTGRES_CONNECTION_STRING=postgresql://user:password@host:port/database

# AI Provider Configuration
# Choose one: ollama, openai
AI_PROVIDER=ollama

# Ollama Configuration (if using ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# OpenAI Configuration (if using openai)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_TEMPERATURE=0.7

# Vector Database Configuration
# Choose one: chromadb, pgvector
VECTOR_DB_TYPE=chromadb

# ChromaDB Configuration (if using chromadb)
VECTOR_DB_PATH=./chroma_db
VECTOR_DB_IMPL=duckdb+parquet

# Application Settings
SAMPLE_DATA_ENABLED=True
LOG_LEVEL=INFO
LOG_FILE=vanna_farsi.log